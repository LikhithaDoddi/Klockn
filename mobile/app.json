{
  "expo": {
    "name": "Klockn",
    "slug": "klockn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.klockn.app",
      "appleTeamId": "MMDX7U6NNW",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Klockn does not use your camera.",
        "NSPhotoLibraryUsageDescription": "Klockn does not access your photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.439208454942-c55pigljsnapf4bv40kvo47rm7isefm0"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.klockn.app",
      "versionCode": 1
    },
    "scheme": "klockn",
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b7bc7c5-4dbc-4bf1-84e3-78f353a78a89"
      }
    }
  }
}

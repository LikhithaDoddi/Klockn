# ─────────────────────────────────────────────
# Klockn — Environment Variables Template
# Copy this file to backend/.env and fill in values
# NEVER commit .env to version control
# In production all secrets live in AWS Secrets Manager
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# AWS RDS PostgreSQL — sslmode=require in production
DATABASE_URL=postgresql://user:password@localhost:5432/klockn

# ── Firebase Auth ─────────────────────────────
# Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Google Calendar API ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/calendar/callback

# ── Anthropic ─────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=2

# ── AWS ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
AWS_SES_REGION=us-east-1
AWS_S3_BUCKET=klockn-storage

# ── Internal service auth ─────────────────────
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_SECRET=change_this_internal_secret

# ── Server ────────────────────────────────────
PORT=4000
NODE_ENV=development

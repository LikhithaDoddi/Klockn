# ─────────────────────────────────────────────
# Klockn — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/klockn
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/klockn_test

# ── Firebase Auth ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Google Calendar API ───────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── Apple Calendar (CalDAV) ───────────────────
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── AI Layer ──────────────────────────────────
# Used for availability optimization and venue suggestions
ANTHROPIC_API_KEY=

# ── Stripe (2% platform fee on ticket revenue) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=2

# ── Backend ───────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string

# ── Web ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# ── AI Service ────────────────────────────────
AI_SERVICE_PORT=5000
AI_SERVICE_SECRET=change_this_internal_secret
